# Frontend (Vite) env template — copy to artifacts/maverick/.env

# REQUIRED by vite.config.ts at build AND dev time (it throws if either is
# missing). PORT is the dev/preview server port; BASE_PATH is the public base
# path the SPA is served from — use "/" when hosted at a domain root
# (e.g. Azure Static Web Apps).
PORT=5173
BASE_PATH=/

# Auth0 (SPA application)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=...
VITE_AUTH0_AUDIENCE=https://api.maverick.local

# Optional — override the dev proxy target if your Node API isn't on 8080.
# In production the SPA is a static bundle; route /api to the Node API at the
# hosting/CDN layer (e.g. Static Web Apps routes or an App Gateway rule).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
