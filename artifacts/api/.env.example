PORT=8080
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
TZ=Asia/Kolkata

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.maverick

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://...
ACS_SENDER=DoNotReply@maverick.example.com

# AI service
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SHARED_SECRET=change-me-64-chars

# Azure Key Vault (prod uses these instead of plain secrets above)
KEY_VAULT_URL=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
