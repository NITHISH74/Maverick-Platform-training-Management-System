# =============================================================================
# Maverick Execution Platform — env template
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- PostgreSQL (Supabase or any Postgres 14+) ----------------------------
# Connection string. Use the Supabase "Transaction" or "Session" pooler URL
# for the api-server; sslmode=require is fine — the Drizzle layer strips it
# and re-applies the right TLS settings (see lib/db/src/index.ts).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Node API (artifacts/api-server) --------------------------------------
PORT=8080
NODE_ENV=development

# Secret used to HMAC-sign the local API token issued after Auth0 exchange
# (see artifacts/api-server/src/lib/auth.ts). REQUIRED in production — the
# server refuses to start without a 16+ char value when NODE_ENV=production.
# Generate one with:  openssl rand -hex 32
API_TOKEN_SECRET=change-me-to-a-long-random-string

# Base URL of the Python FastAPI AI service. In local dev this defaults to
# http://localhost:9000. In Azure set it to the AI Container App's internal
# URL, e.g. https://maverick-ai.internal.<region>.azurecontainerapps.io
AI_SERVICE_URL=http://localhost:9000

# --- Internal token shared between Node API and FastAPI -------------------
# Used by routes/copilot.ts, /trainer-scoring, /feedback-intelligence to
# authenticate to the FastAPI service. Keep this secret. Any random
# 32+ char string is fine.
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string
AI_INTERNAL_TOKEN=change-me-to-a-long-random-string

# --- Supabase project (used by Python AI service) -------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Optional: monitoring scheduler ---------------------------------------
# Set to true to start the cron loop at server boot (see lib/scheduler.ts).
# Without this the monitoring agent still works via "Run scan now" in the UI.
ENABLE_MONITORING_SCHEDULER=false

# --- Email delivery (monitoring agent + V6/V7 notifications & feedback) ---
# If unset, lib/email.ts uses a console transport that logs every "email"
# to monitoring_email_log with provider='console'. Set these to flip to
# real SMTP (Gmail uses an app password, not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Maverick TMS" <your-sender@gmail.com>

# Address CC'd on every automated alert / feedback email (escalation inbox).
NOTIFICATION_CC=escalations@example.com
