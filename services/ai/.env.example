# FastAPI AI service env template — copy to services/ai/.env

# Azure OpenAI deployment (GPT-4.1) — required for Copilot, trainer scoring,
# feedback intelligence, monitoring AI summary.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Supabase (read by the AI service for RAG / direct queries).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Postgres (used by Copilot, trainer scoring, feedback intelligence).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Must match INTERNAL_SHARED_SECRET in the root .env.
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

# Optional Sentry DSN
# SENTRY_DSN=
