# --- Email delivery (V6/V7 notification + feedback emails) ----------------
# Real Gmail SMTP. When these are set, lib/email.ts sends via nodemailer;
# otherwise it falls back to the console transport (logs only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adminmavericktms@gmail.com
SMTP_PASS=hkoz nprz rewz qlwt
SMTP_FROM=Maverick TMS <adminmavericktms@gmail.com>

# Address CC'd on every automated alert / feedback email (escalation inbox).
NOTIFICATION_CC=nithishwarsenthilkumaran@gmail.com

# Start the hourly notification heartbeat + daily monitoring cron at boot.
ENABLE_MONITORING_SCHEDULER=true

# --- Node <-> Python AI service shared secret (x-internal-token) -----------
# The AI service is launched from the repo root (uvicorn --app-dir services/ai),
# so Pydantic reads THIS .env, not services/ai/.env. These must match the
# INTERNAL_SHARED_SECRET in services/ai/.env or every /ai, /copilot,
# /trainer-scoring and PDF call returns 401 "invalid internal token".
INTERNAL_SHARED_SECRET=smoke-test-secret-1234567890
AI_INTERNAL_TOKEN=smoke-test-secret-1234567890
